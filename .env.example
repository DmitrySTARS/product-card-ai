# Скопируйте в .env и подставьте реальные значения.
# Файл .env добавлен в .gitignore и не попадает в репозиторий.

# Какой провайдер использовать: offline | openai | anthropic
PCA_PROVIDER=offline

# Ключ нужен только для provider=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ключ нужен только для provider=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Таймаут HTTP-запроса к LLM, секунды
PCA_TIMEOUT=60
